@model myshop.Application.Services.Order.Dto.OrderDetailsDto
@using myshop.Domain.Entities.Enums
@{
    Layout = "_ShopHubLayout";
    ViewData["Title"] = "ShopHub — Order Details";
    var itemCount = Model.Items.Sum(i => i.Quantity);
    var statusClass = Model.OrderStatus switch
    {
        OrderStatus.Processing => "sh-pill-processing",
        OrderStatus.Shipped => "sh-pill-shipped",
        OrderStatus.Delivered => "sh-pill-delivered",
        OrderStatus.Cancelled => "sh-pill-cancelled",
        _ => "sh-pill-processing"
    };
    var paymentClass = Model.PaymentStatus switch
    {
        PaymentStatus.Paid => "sh-pill-delivered",
        PaymentStatus.Pending => "sh-pill-processing",
        PaymentStatus.Failed => "sh-pill-cancelled",
        _ => "sh-pill-processing"
    };
}

@section Styles {
    <style>
        .sh-crumb { max-width: 1320px; margin: 0 auto; padding: 22px 44px 54px; display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
        .sh-crumb-path { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: oklch(0.92 0.17 118); margin-bottom: 12px; animation: shUp 0.7s 0.08s ease-out both; }
        .sh-crumb-title { font-size: 54px; font-weight: 700; line-height: 1.05; letter-spacing: -0.03em; margin: 0; animation: shUp 0.7s 0.08s ease-out both; display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
        .sh-crumb-summary { font-size: 14.5px; color: oklch(0.92 0.02 268 / 0.78); animation: shUp 0.7s 0.16s ease-out both; }

        .sh-cart-panel { background: oklch(0.975 0.006 280); color: oklch(0.24 0.02 268); border-radius: 42px 42px 0 0; padding: 46px 0 0; }
        .sh-cart-layout { max-width: 1320px; margin: 0 auto; padding: 0 44px 70px; display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(280px, 0.85fr); gap: 30px; align-items: start; }

        .sh-cart-table-card { background: oklch(1 0 0); border: 1px solid oklch(0.9 0.012 280); border-radius: 20px; overflow: hidden; min-width: 0; }
        .sh-cart-table-scroll { overflow-x: auto; overflow-y: hidden; }
        .cart-row-grid { display: grid; grid-template-columns: minmax(240px, 2.4fr) minmax(80px, 0.7fr) 90px minmax(90px, 0.7fr); gap: 16px; align-items: center; min-width: 620px; }
        .sh-cart-head-row { padding: 18px 24px; border-bottom: 1px solid oklch(0.92 0.01 280); background: oklch(0.98 0.005 280); font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: oklch(0.5 0.03 280); }
        .cart-row { padding: 20px 24px; border-bottom: 1px solid oklch(0.94 0.008 280); animation: shIn 0.55s ease-out both; }
        .cart-row:last-child { border-bottom: none; }

        .cart-row-product { display: flex; align-items: center; gap: 16px; min-width: 0; }
        .cart-row-thumb { width: 84px; height: 84px; flex: none; border-radius: 14px; object-fit: contain; background-color: oklch(0.93 0.012 280); padding: 6px; }
        .cart-row-info { min-width: 0; }
        .cart-row-name { font-size: 16px; font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
        .cart-row-sku { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; color: oklch(0.55 0.02 280); margin-top: 5px; }
        .cart-row-unit { text-align: right; font-size: 14.5px; color: oklch(0.4 0.02 280); white-space: nowrap; }
        .cart-row-qty { text-align: center; font-family: 'IBM Plex Mono', monospace; font-size: 13.5px; color: oklch(0.4 0.02 280); }
        .cart-row-total { text-align: right; font-size: 17px; font-weight: 700; white-space: nowrap; }

        .sh-pill { display: inline-block; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; padding: 8px 15px; border-radius: 999px; white-space: nowrap; }
        .sh-pill-processing { background: oklch(0.94 0.05 268 / 0.5); color: oklch(0.42 0.13 268); }
        .sh-pill-shipped { background: oklch(0.92 0.1 285 / 0.4); color: oklch(0.45 0.15 285); }
        .sh-pill-delivered { background: oklch(0.92 0.12 145 / 0.45); color: oklch(0.4 0.13 145); }
        .sh-pill-cancelled { background: oklch(0.92 0.08 25 / 0.45); color: oklch(0.5 0.18 25); }

        .sh-summary-aside { position: sticky; top: 24px; min-width: 0; display: flex; flex-direction: column; gap: 16px; animation: shIn 0.7s 0.2s ease-out both; }
        .sh-summary-card { background: oklch(0.24 0.05 268); color: oklch(0.97 0.01 268); border-radius: 20px; padding: 26px; }
        .sh-summary-eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: oklch(0.92 0.17 118); margin-bottom: 20px; }
        .sh-summary-rows { display: flex; flex-direction: column; gap: 13px; font-size: 14px; padding-bottom: 18px; border-bottom: 1px solid oklch(1 0 0 / 0.14); }
        .sh-summary-row { display: flex; justify-content: space-between; gap: 12px; }
        .sh-summary-row span:first-child { color: oklch(0.88 0.01 268 / 0.72); }
        .sh-summary-total-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 20px 0 4px; }
        .sh-summary-total-label { font-size: 15px; font-weight: 600; }
        .sh-summary-total-amount { font-size: 32px; font-weight: 700; letter-spacing: -0.02em; color: oklch(0.92 0.17 118); }

        .sh-ship-card { background: oklch(1 0 0); border: 1px solid oklch(0.9 0.012 280); border-radius: 20px; padding: 26px; }
        .sh-ship-label { font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: oklch(0.5 0.03 280); margin-bottom: 16px; }
        .sh-ship-rows { display: flex; flex-direction: column; gap: 11px; font-size: 14px; }
        .sh-ship-row span:first-child { color: oklch(0.5 0.02 280); }
        .sh-ship-row { display: flex; justify-content: space-between; gap: 12px; }

        .sh-back-link { font-size: 13px; font-weight: 500; color: oklch(0.42 0.03 280); }
        .sh-back-link:hover { color: oklch(0.48 0.13 268); }

        @@media (max-width: 900px) {
            .sh-crumb-title { font-size: 34px; }
            .sh-cart-layout { grid-template-columns: 1fr; }
            .sh-summary-aside { position: static; }
        }
    </style>
}

<section class="sh-crumb">
    <div>
        <div class="sh-crumb-path"><a asp-controller="Home" asp-action="Index">Home</a> / <a asp-controller="Order" asp-action="MyOrders">My Orders</a> / SH-@Model.Id.ToString("D5")</div>
        <h1 class="sh-crumb-title">Order SH-@Model.Id.ToString("D5") <span class="sh-pill @statusClass">@Model.OrderStatus</span></h1>
    </div>
    <div class="sh-crumb-summary">Placed @Model.OrderDate.ToString("MMM d, yyyy 'at' h:mm tt")</div>
</section>

<section class="sh-cart-panel">
    <div class="sh-cart-layout">

        <div class="sh-cart-table-card">
            <div class="sh-cart-table-scroll">
                <div class="cart-row-grid sh-cart-head-row">
                    <div>Product</div>
                    <div style="text-align:right;">Unit price</div>
                    <div style="text-align:center;">Qty</div>
                    <div style="text-align:right;">Total</div>
                </div>

                @foreach (var item in Model.Items)
                {
                    <div class="cart-row-grid cart-row">
                        <div class="cart-row-product">
                            <img class="cart-row-thumb" src="~/@(string.IsNullOrEmpty(item.ProductImg) ? "img/default-150x150.png" : item.ProductImg)" alt="@item.ProductName" />
                            <div class="cart-row-info">
                                <div class="cart-row-name">@item.ProductName</div>
                                <div class="cart-row-sku">SH-@item.ProductId.ToString("D4")</div>
                            </div>
                        </div>
                        <div class="cart-row-unit">$@item.UnitPrice.ToString("N2")</div>
                        <div class="cart-row-qty">&times;@item.Quantity</div>
                        <div class="cart-row-total">$@((item.UnitPrice * item.Quantity).ToString("N2"))</div>
                    </div>
                }
            </div>
        </div>

        <aside class="sh-summary-aside">
            <div class="sh-ship-card">
                <div class="sh-ship-label">Delivery details</div>
                <div class="sh-ship-rows">
                    <div class="sh-ship-row"><span>Recipient</span><span>@Model.RecipientName</span></div>
                    <div class="sh-ship-row"><span>Address</span><span>@Model.Address</span></div>
                    <div class="sh-ship-row"><span>City</span><span>@Model.City</span></div>
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <div class="sh-ship-row"><span>Phone</span><span>@Model.PhoneNumber</span></div>
                    }
                    <div class="sh-ship-row"><span>Payment</span><span class="sh-pill @paymentClass">@Model.PaymentStatus</span></div>
                </div>
            </div>

            <div class="sh-summary-card">
                <div class="sh-summary-eyebrow">Order summary</div>
                <div class="sh-summary-rows">
                    <div class="sh-summary-row"><span>Items (@itemCount)</span><span>$@Model.TotalPrice.ToString("N2")</span></div>
                </div>
                <div class="sh-summary-total-row">
                    <span class="sh-summary-total-label">Order Total</span>
                    <span class="sh-summary-total-amount">$@Model.TotalPrice.ToString("N2")</span>
                </div>
            </div>

            <a asp-controller="Order" asp-action="MyOrders" class="sh-back-link">&larr; Back to my orders</a>
        </aside>
    </div>
</section>
