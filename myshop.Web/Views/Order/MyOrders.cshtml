@model IEnumerable<myshop.Application.Services.Order.Dto.OrderSummaryDto>
@using myshop.Domain.Entities.Enums
@{
    Layout = "_ShopHubLayout";
    ViewData["Title"] = "ShopHub — My Orders";
    var orders = Model.ToList();
}

@section Styles {
    <style>
        .sh-crumb { max-width: 1320px; margin: 0 auto; padding: 22px 44px 54px; display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
        .sh-crumb-path { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: oklch(0.92 0.17 118); margin-bottom: 12px; animation: shUp 0.7s 0.08s ease-out both; }
        .sh-crumb-title { font-size: 54px; font-weight: 700; line-height: 1.05; letter-spacing: -0.03em; margin: 0; animation: shUp 0.7s 0.08s ease-out both; }
        .sh-crumb-summary { font-size: 14.5px; color: oklch(0.92 0.02 268 / 0.78); animation: shUp 0.7s 0.16s ease-out both; }

        .sh-cart-panel { background: oklch(0.975 0.006 280); color: oklch(0.24 0.02 268); border-radius: 42px 42px 0 0; padding: 46px 0 0; }
        .sh-orders-layout { max-width: 1320px; margin: 0 auto; padding: 0 44px 70px; }

        .sh-cart-table-card { background: oklch(1 0 0); border: 1px solid oklch(0.9 0.012 280); border-radius: 20px; overflow: hidden; min-width: 0; }
        .sh-cart-table-scroll { overflow-x: auto; overflow-y: hidden; }
        .order-row-grid { display: grid; grid-template-columns: 130px minmax(140px, 1fr) 110px minmax(120px, 0.8fr) minmax(120px, 0.8fr) 130px; gap: 16px; align-items: center; min-width: 780px; }
        .sh-cart-head-row { padding: 18px 24px; border-bottom: 1px solid oklch(0.92 0.01 280); background: oklch(0.98 0.005 280); font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: oklch(0.5 0.03 280); }
        .order-row { padding: 20px 24px; border-bottom: 1px solid oklch(0.94 0.008 280); animation: shIn 0.55s ease-out both; }
        .order-row:last-child { border-bottom: none; }

        .order-row-id { font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: oklch(0.4 0.02 280); }
        .order-row-date { font-size: 14px; color: oklch(0.35 0.02 268); }
        .order-row-items { font-size: 13.5px; color: oklch(0.5 0.02 280); text-align: center; }
        .order-row-total { font-size: 16px; font-weight: 700; }
        .order-row-view { justify-self: end; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.12em; text-transform: uppercase; padding: 10px 18px; border-radius: 999px; border: 1px solid oklch(0.88 0.012 280); background: transparent; color: oklch(0.42 0.03 280); white-space: nowrap; transition: all 0.2s ease; }
        .order-row-view:hover { background: oklch(0.48 0.13 268); border-color: oklch(0.48 0.13 268); color: oklch(0.99 0.01 268); }

        .sh-pill { display: inline-block; font-family: 'IBM Plex Mono', monospace; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; padding: 7px 13px; border-radius: 999px; white-space: nowrap; }
        .sh-pill-processing { background: oklch(0.94 0.05 268 / 0.5); color: oklch(0.42 0.13 268); }
        .sh-pill-shipped { background: oklch(0.92 0.1 285 / 0.4); color: oklch(0.45 0.15 285); }
        .sh-pill-delivered { background: oklch(0.92 0.12 145 / 0.45); color: oklch(0.4 0.13 145); }
        .sh-pill-cancelled { background: oklch(0.92 0.08 25 / 0.45); color: oklch(0.5 0.18 25); }

        .sh-orders-empty { padding: 78px 24px; text-align: center; }
        .sh-orders-empty-icon { width: 74px; height: 74px; margin: 0 auto 20px; border-radius: 999px; background: oklch(0.95 0.012 280); display: flex; align-items: center; justify-content: center; font-size: 26px; color: oklch(0.5 0.03 280); }
        .sh-orders-empty-title { font-size: 20px; font-weight: 600; margin-bottom: 8px; }
        .sh-orders-empty-sub { font-size: 14px; color: oklch(0.5 0.02 280); margin-bottom: 24px; }
        .sh-orders-empty-cta { display: inline-block; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; padding: 14px 28px; border-radius: 999px; background: oklch(0.48 0.13 268); color: oklch(0.99 0.01 268); }
        .sh-orders-empty-cta:hover { background: oklch(0.92 0.17 118); color: oklch(0.28 0.08 130); }

        @@media (max-width: 900px) {
            .sh-crumb-title { font-size: 38px; }
        }
    </style>
}

<section class="sh-crumb">
    <div>
        <div class="sh-crumb-path"><a asp-controller="Home" asp-action="Index">Home</a> / My Orders</div>
        <h1 class="sh-crumb-title">My orders</h1>
    </div>
    <div class="sh-crumb-summary">@orders.Count order@(orders.Count == 1 ? "" : "s")</div>
</section>

<section class="sh-cart-panel">
    <div class="sh-orders-layout">
        @if (!orders.Any())
        {
            <div class="sh-cart-table-card">
                <div class="sh-orders-empty">
                    <div class="sh-orders-empty-icon">⛬</div>
                    <div class="sh-orders-empty-title">No orders yet</div>
                    <div class="sh-orders-empty-sub">Once you place an order, it'll show up here.</div>
                    <a asp-controller="Home" asp-action="Index" asp-fragment="shop" class="sh-orders-empty-cta">Start shopping</a>
                </div>
            </div>
        }
        else
        {
            <div class="sh-cart-table-card">
                <div class="sh-cart-table-scroll">
                    <div class="order-row-grid sh-cart-head-row">
                        <div>Order</div>
                        <div>Date</div>
                        <div style="text-align:center;">Items</div>
                        <div>Status</div>
                        <div>Payment</div>
                        <div></div>
                    </div>

                    @foreach (var order in orders)
                    {
                        var statusClass = order.OrderStatus switch
                        {
                            OrderStatus.Processing => "sh-pill-processing",
                            OrderStatus.Shipped => "sh-pill-shipped",
                            OrderStatus.Delivered => "sh-pill-delivered",
                            OrderStatus.Cancelled => "sh-pill-cancelled",
                            _ => "sh-pill-processing"
                        };
                        var paymentClass = order.PaymentStatus switch
                        {
                            PaymentStatus.Paid => "sh-pill-delivered",
                            PaymentStatus.Pending => "sh-pill-processing",
                            PaymentStatus.Failed => "sh-pill-cancelled",
                            _ => "sh-pill-processing"
                        };
                        <div class="order-row-grid order-row">
                            <div class="order-row-id">SH-@order.Id.ToString("D5")</div>
                            <div class="order-row-date">@order.OrderDate.ToString("MMM d, yyyy")</div>
                            <div class="order-row-items">@order.ItemCount</div>
                            <div><span class="sh-pill @statusClass">@order.OrderStatus</span></div>
                            <div><span class="sh-pill @paymentClass">@order.PaymentStatus</span></div>
                            <a asp-controller="Order" asp-action="OrderDetails" asp-route-id="@order.Id" class="order-row-view">View</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>
